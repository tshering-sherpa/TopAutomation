<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TopAutomation - Security (web)" parallel="methods" thread-count="3" data-provider-thread-count="3" verbose="1">
    <listeners>
        <listener class-name="com.topautomation.core.reporting.TestListener"/>
        <listener class-name="com.topautomation.core.reporting.AnnotationTransformer"/>
    </listeners>
    <test name="Web injection">
        <groups>
            <run>
                <include name="security-web"/>
            </run>
        </groups>
        <packages>
            <package name="com.topautomation.security.tests.web"/>
        </packages>
    </test>
</suite>
