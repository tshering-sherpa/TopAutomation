<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TopAutomation - Security (API)" parallel="methods" thread-count="5" data-provider-thread-count="5" verbose="1">
    <listeners>
        <listener class-name="com.topautomation.core.reporting.TestListener"/>
        <listener class-name="com.topautomation.core.reporting.AnnotationTransformer"/>
    </listeners>
    <test name="API injection">
        <groups>
            <run>
                <include name="security-api"/>
            </run>
        </groups>
        <packages>
            <package name="com.topautomation.security.tests.api"/>
        </packages>
    </test>
</suite>
