<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TopAutomation - Security (web + API + mobile)" verbose="1">
    <listeners>
        <listener class-name="com.topautomation.core.reporting.TestListener"/>
        <listener class-name="com.topautomation.core.reporting.AnnotationTransformer"/>
    </listeners>
    <test name="Web injection">
        <groups>
            <run>
                <include name="security-web"/>
            </run>
        </groups>
        <packages>
            <package name="com.topautomation.security.tests.web"/>
        </packages>
    </test>
    <test name="API injection">
        <groups>
            <run>
                <include name="security-api"/>
            </run>
        </groups>
        <packages>
            <package name="com.topautomation.security.tests.api"/>
        </packages>
    </test>
    <test name="Mobile injection">
        <groups>
            <run>
                <include name="security-mobile"/>
            </run>
        </groups>
        <packages>
            <package name="com.topautomation.security.tests.mobile"/>
        </packages>
    </test>
</suite>
