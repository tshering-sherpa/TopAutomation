<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TopAutomation - Web regression" parallel="methods" thread-count="3" data-provider-thread-count="3" verbose="1">
    <listeners>
        <listener class-name="com.topautomation.core.reporting.TestListener"/>
        <listener class-name="com.topautomation.core.reporting.AnnotationTransformer"/>
    </listeners>
    <test name="Web regression">
        <groups>
            <run>
                <include name="web-regression"/>
            </run>
        </groups>
        <packages>
            <package name="com.topautomation.web.tests"/>
        </packages>
    </test>
</suite>
